{
  "healthCheck": "/api/health",
  "egress": "unrestricted",
  "resources": { "size": "medium" },
  "scaling": { "replicas": 1, "autoscaling": true, "minReplicas": 1, "maxReplicas": 3 },
  "workers": [
    { "name": "asset-builder", "command": "node asset-worker.cjs", "replicas": 1, "resources": { "size": "medium" } }
  ],
  "webhooks": [
    "/api/diagnostics/acos",
    "/api/diagnostics/glean",
    "/api/diagnostics/integrations",
    "/api/diagnostics/confluence",
    "/api/diagnostics/outcomes",
    "/api/diagnostics/spine"
  ],
  "acosData": {
    "vendors": ["confluence", "slack", "jira", "glean"],
    "mcp": ["glean"],
    "write": ["jira:create-issue"]
  },
  "cron": [
    { "schedule": "0 14 * * 1-5", "path": "/api/cron/nudge", "method": "POST", "description": "Weekday stale-request nudges (9am CT)" },
    { "schedule": "0 12 * * 1", "path": "/api/cron/refresh-spine", "method": "POST", "description": "Weekly Spine framework refresh from Confluence (no-ops until page id + appAccess configured)" }
  ]
}
