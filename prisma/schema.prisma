generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Lifecycle. Phase-2 statuses (GENERATING, DRAFT_READY) are included now so
// the enum never needs a migration when asset generation lands.
// ---------------------------------------------------------------------------
enum RequestStatus {
  SUBMITTED // created, assessment queued
  ASSESSING // LLM assessment in flight
  NEEDS_INFO // agent posted scoping questions; waiting on stakeholder
  RECOMMENDED // assessment complete; waiting on stakeholder confirm/decline
  CONFIRMED // stakeholder confirmed scope + deliverable (V1 terminal for AUTONOMOUS)
  GENERATING // phase 2: asset generation in flight
  DRAFT_READY // phase 2: draft asset awaiting operator review
  HANDOFF_REQUIRED // deliverable needs a human build (Rise/Solidroad) — operator queue
  APPROVED // operator approved handoff / draft
  DELIVERED // asset delivered (phase 2) or handoff completed
  DECLINED // stakeholder or operator declined (requires category+reason)
  ARCHIVED
}

enum DeliverableType {
  JOB_AID
  MANAGER_GUIDE
  DECK
  SOLIDROAD_SIM_SPEC
  RISE_COURSE
  OTHER
  SELF_SERVE_RESOURCE
}

enum Autonomy {
  AUTONOMOUS
  HUMAN_HANDOFF
}

enum AssetBuildStatus {
  QUEUED
  RUNNING
  DRAFT_READY
  APPROVED
  DELIVERED
  FAILED
}

enum AssetArtifactKind {
  MARKDOWN
  DECK_STORYBOARD
  DOCX
}

enum MessageRole {
  STAKEHOLDER
  AGENT
  OPERATOR
}

model TrainingRequest {
  id              String           @id @default(cuid())
  title           String
  description     String           @db.Text // situation, challenge, or initiative
  requesterEmail  String // from SSO header
  requestType     String?          // requester starting point; never a binding solution choice
  businessImpact  String?          @db.Text // business outcome the stakeholder wants
  successMeasures String?          @db.Text // observable indicators of success
  desiredBehavior String?          @db.Text // who should do what differently, when, and how
  audience        String? // who is being trained
  businessGoal    String?          @db.Text // legacy combined impact + success measure field
  urgency         String? // freeform ("this quarter", "before June launch")
  stakeholders    String?          @db.Text // advocates, approvers, reviewers, and SMEs
  sourceMaterials String?          @db.Text // available or in-progress build inputs
  accountability  String?          @db.Text // reinforcement and expectations after the support lands
  dueDate         DateTime?
  contentLinks    String[] // source material URLs (Confluence, GDocs, …)
  pixelDoodle     Json?
  jiraIssueKey    String?          @unique
  jiraIssueUrl    String?
  jiraSyncStatus  String           @default("PENDING")
  jiraSyncError   String?          @db.Text
  status          RequestStatus    @default(SUBMITTED)
  recommendedType DeliverableType? // denormalized primary recommendation
  autonomy        Autonomy? // derived server-side from recommendedType
  confirmedType   DeliverableType? // what the stakeholder confirmed (may differ after override)
  assignedTo      String? // operator email
  overrideReason  String?          @db.Text // when operator overrides the recommendation
  lastActivityAt  DateTime         @default(now()) // drives stale nudges
  lastNudgedAt    DateTime?
  assessments     Assessment[]
  messages        RequestMessage[]
  actions         RequestAction[]
  feedback        RequestFeedback[]
  assetBuilds     AssetBuild[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([requesterEmail])
  @@index([createdAt(sort: Desc)])
}

// One row per LLM assessment pass (re-runs after NEEDS_INFO bump version).
model Assessment {
  id               String          @id @default(cuid())
  requestId        String
  request          TrainingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  version          Int // 1..n per request
  model            String // e.g. claude-sonnet-4-6
  frameworkVersion String // Spine doc version/hash used
  sufficient       Boolean // false → NEEDS_INFO
  missingInputs    String[] // what's missing when insufficient
  spineSteps       Json // [{ step, summary }] per Spine stage
  recommendations  Json // [{ deliverableType, rationale, confidence, effort: {size,hours} }]
  scopingQuestions String[]
  currentStage     String? // Design, Motivate, Train, Plan, Reinforce, or Measure
  workingNotes     Json? // compact copilot memory for the current assessment pass
  nextDecision     Json? // { question, options[] } when a stakeholder decision is open
  madeMaterialProgress Boolean @default(false)
  nonProgressTurns Int @default(0)
  showWorkingNotes Boolean @default(false)
  rawExcerpt       String?         @db.Text // first ~2k chars of raw LLM output for debugging
  error            String?         @db.Text // non-null if the pass failed
  createdAt        DateTime        @default(now())

  @@index([requestId, version(sort: Desc)])
}

// Q&A thread on the request detail page.
model RequestMessage {
  id        String          @id @default(cuid())
  requestId String
  request   TrainingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  role      MessageRole
  author    String // email or "agent"
  body      String          @db.Text
  metadata  Json            @default("{}") // e.g. { assessmentId } when agent posts questions
  createdAt DateTime        @default(now())

  @@index([requestId, createdAt])
}

// Audit trail — every state transition and notable act, with the SSO actor.
model RequestAction {
  id        String          @id @default(cuid())
  requestId String
  request   TrainingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  action    String // e.g. "status:SUBMITTED→ASSESSING", "assessed", "nudged"
  actor     String? // SSO email, or null for system
  source    String // 'ui' | 'cron' | 'system'
  metadata  Json            @default("{}")
  createdAt DateTime        @default(now())

  @@index([requestId])
}

// Decline/override training signal — fed back into future assessments as
// negative examples (doc-auditor feedback-learning pattern).
model RequestFeedback {
  id        String          @id @default(cuid())
  requestId String
  request   TrainingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  category  String // 'wrong_deliverable' | 'not_training_problem' | 'duplicate_request' | 'too_big_for_agent' | 'no_longer_needed' | 'other'
  reason    String          @db.Text
  actor     String?
  createdAt DateTime        @default(now())

  @@index([category, createdAt(sort: Desc)])
}

model AssetBuild {
  id              String           @id @default(cuid())
  requestId       String
  request         TrainingRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  deliverableType DeliverableType
  status          AssetBuildStatus @default(QUEUED)
  revision        Int              @default(1)
  attempt         Int              @default(0)
  workerId        String?
  startedAt       DateTime?
  heartbeatAt     DateTime?
  completedAt     DateTime?
  draftTitle      String?
  draftSummary    String?          @db.Text
  draftContent    String?          @db.Text
  draftData       Json?
  sourceSnapshot  Json?
  error           String?          @db.Text
  artifacts       AssetArtifact[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([requestId, deliverableType, revision])
  @@index([status, createdAt])
  @@index([requestId, createdAt(sort: Desc)])
}

model AssetArtifact {
  id          String            @id @default(cuid())
  buildId     String
  build       AssetBuild        @relation(fields: [buildId], references: [id], onDelete: Cascade)
  kind        AssetArtifactKind
  fileName    String
  contentType String
  objectKey   String            @unique
  sizeBytes   Int
  sha256      String
  createdAt   DateTime          @default(now())

  @@index([buildId, createdAt])
}

// Versioned Spine framework content (repo seed + optional Confluence refresh).
model FrameworkDoc {
  id          String   @id @default(cuid())
  source      String // 'REPO' | 'CONFLUENCE'
  version     String // page-version or content-hash short form
  contentHash String   @unique
  content     String   @db.Text
  fetchedAt   DateTime @default(now())

  @@index([fetchedAt(sort: Desc)])
}
